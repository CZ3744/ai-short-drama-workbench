# Optional: copy to .env. Prefer Settings > Add model for everyday use.
# Each installation supplies its OWN API credentials. Never commit .env.
# No keys are required to open the app, write scripts, or import existing media.
SERVER_PORT=8788
WEB_ORIGIN=http://127.0.0.1:5173

# Choose a provider and model in Settings. This generic template has no account.
GLOBAL_MODEL_PROVIDER=custom_openai_compat
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MIMO_API_KEY=

# Built-in local card renderer produces clearly labeled sample artwork.
IMAGE_PROVIDER=local_card_image
IMAGE_API_KEY=
IMAGE_RESOLUTION=1920x1080

# Select your video model in Settings, or import existing clips.
VIDEO_API_KEY=
VIDEO_ASPECT_RATIO=16:9
VIDEO_DURATION_PER_SCENE=6
MINIMAX_API_KEY=
ALIYUN_DASHSCOPE_API_KEY=
VIDU_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
JIMENG_VOLC_ACCESS_KEY=
JIMENG_VOLC_SECRET_KEY=
ZHIPU_API_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Optional narration; Edge TTS needs network access and its Python package.
TTS_PROVIDER=edge_tts
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=+0%
SUBTITLE_MODE=both

# Leave empty to resolve ffmpeg/ffprobe from PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Local budget guard in CNY. Provider billing remains authoritative.
BUDGET_DAILY_CNY=20
BUDGET_PER_JOB_CNY=5
BUDGET_PER_PROVIDER_CNY=10
