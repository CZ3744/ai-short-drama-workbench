{
  "name": "script-driven-ai-video-generate",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "type": "module",
  "description": "Local-first AI video studio with editable scripts, storyboards, media, and your own model providers.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite apps/web --host 127.0.0.1 --port 5173",
    "server": "tsx apps/server/src/index.ts",
    "web": "vite apps/web --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build apps/web",
    "demo": "tsx scripts/run-sample.ts",
    "validate": "tsx scripts/validate-output.ts",
    "validate:job": "tsx scripts/validate-output.ts",
    "check:llm": "tsx scripts/check-llm.ts",
    "smoke:stable": "tsx scripts/smoke-phase-stable.ts",
    "health:codebase": "tsx scripts/codebase-health.ts && tsx scripts/health-extension-completeness.ts",
    "health:extension": "tsx scripts/health-extension-completeness.ts",
    "test": "npm run test:all",
    "test:all": "node scripts/run-safe-tests.mjs",
    "test:browser": "npm run build && node scripts/run-safe-tests.mjs --browser",
    "test:quality": "node scripts/run-safe-tests.mjs taskSynchronization clientDisconnectSignal logging-chain clipScorer",
    "test:unit": "node scripts/run-safe-tests.mjs promptCompiler.golden.test",
    "test:e2e-smoke": "tsx scripts/test-e2e-auto.ts",
    "test:pre-api": "npm run build && npm run smoke:stable && npm run health:codebase",
    "migrate:shot-picked-video": "tsx scripts/migrate-shot-picked-video.ts",
    "workspace:merge:plan": "tsx scripts/consolidate-project-roots.ts",
    "workspace:merge": "tsx scripts/consolidate-project-roots.ts --apply",
    "verify:clean-install": "node scripts/verify-clean-install.mjs",
    "check:privacy": "node scripts/check-release-privacy.mjs",
    "release:export": "node scripts/export-release.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tiptap/extension-character-count": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@vitejs/plugin-react": "6.0.2",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "file-type": "^22.0.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.8.0",
    "marked": "^18.0.3",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.15.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tsx": "4.23.15",
    "ulid": "^2.3.0",
    "zod": "^4.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "vite": "8.0.16"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT"
}
